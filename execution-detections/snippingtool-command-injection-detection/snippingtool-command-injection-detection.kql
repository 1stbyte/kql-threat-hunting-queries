// Detection: Snipping Tool Command Injection Behavior
// Data Source: Microsoft Defender Advanced Hunting (DeviceProcessEvents)
// MITRE Technique: T1059 – Command and Scripting Interpreter

DeviceProcessEvents
| where Timestamp > ago(7d)
| where InitiatingProcessFileName =~ "SnippingTool.exe"
| where FileName in~ ("cmd.exe","powershell.exe","wscript.exe","cscript.exe","mshta.exe")
| where ProcessCommandLine has_any (";", "&", "|")
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp desc
