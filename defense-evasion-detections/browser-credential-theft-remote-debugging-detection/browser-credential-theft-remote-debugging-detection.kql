// Detection: Browser Credential Theft via Remote Debugging
// Data Source: Microsoft Defender Advanced Hunting (DeviceProcessEvents)
// MITRE Technique: T1555 — Credentials from Password Stores
// Related Technique: T1564 — Hide Artifacts
// Tactic: Credential Access / Defense Evasion
// Description:
// Detects Chrome or Edge launched with remote debugging flags by suspicious parent processes,
// which may indicate browser credential or session token theft activity.

DeviceProcessEvents
| where Timestamp > ago(7d)
| where InitiatingProcessFileName in~ (
    "powershell.exe",
    "cmd.exe",
    "wscript.exe",
    "cscript.exe",
    "mshta.exe",
    "rundll32.exe"
)
| where FileName in~ ("chrome.exe", "msedge.exe")
| where ProcessCommandLine has_any (
    "--remote-debugging",
    "--remote-debugging-port",
    "--headless",
    "--user-data-dir"
)
| extend CommandLineRisk = case(
    ProcessCommandLine has "--remote-debugging-port", "High - Remote Debugging Port Enabled",
    ProcessCommandLine has "--user-data-dir", "Medium - Custom Browser Profile Directory",
    ProcessCommandLine has "--headless", "Medium - Headless Browser Execution",
    "Review"
)
| project
    Timestamp,
    DeviceName,
    AccountName,
    InitiatingProcessFileName,
    FileName,
    FolderPath,
    CommandLineRisk,
    ProcessCommandLine
| order by Timestamp desc
